local function mkBtn(name, text, pos, size, ts, parent)
    local b = Instance.new("TextButton")
    b.Name, b.Parent = name, parent or Scroll
    b.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    b.Position, b.Size = pos, size
    b.Font, b.Text = Enum.Font.SourceSansBold, text
    b.TextColor3, b.TextSize = Color3.fromRGB(255, 255, 255), ts or 14
    b.AutoButtonColor = true
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = b
    return b
end

local function mkLabel(name, text, pos, size, parent)
    local l = Instance.new("TextLabel")
    l.Name, l.Parent = name, parent or Scroll
    l.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
    l.Position, l.Size = pos, size
    l.Font, l.Text = Enum.Font.SourceSansBold, text
    l.TextColor3, l.TextSize = Color3.fromRGB(255, 255, 255), 14
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, 6); c.Parent = l
    return l
end

