local gravState = 1
local function cycleGravity()
    local options = {originalGravity, 50, 20, 5, 196.2}
    gravState = (gravState % #options) + 1
    workspace.Gravity = options[gravState]
    gravityBtn.Text = "Gravity " .. math.floor(options[gravState])
end

--============ APPLY WSPD + JPWR ============
local function applyWSJP()
    local c = LP.Character
    local h = c and c:FindFirstChildWhichIsA("Humanoid")
    if not h then return end
    local ws = tonumber(wsBox.Text)
    local jp = tonumber(jpBox.Text)
    if ws then h.WalkSpeed = ws end
    if jp then h.JumpPower = jp; h.UseJumpPower = true end
end

--============ TOGGLE SYSTEM ============
local function setToggle(name, on, btn)
    toggles[name] = on
    if btn then
        btn.Text = (on and "✅ " or "⬜ ") .. btn.Text:gsub("^[✅⬜] ", "")
    end
end

