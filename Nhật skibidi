local function setXray(on)
    if on then
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Transparency < 1 and v:GetAttribute("FLY_XRAY") == nil then
                v:SetAttribute("FLY_XRAY", v.Transparency)
